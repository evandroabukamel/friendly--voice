<?xml version="1.0" encoding="utf-8"?>
<!-- Optional quiet hours: no message between "from" and "to". -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.FriendlyVoice.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.FriendlyVoice.Text.CardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/quiet_title" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/quiet_switch"
                style="@style/Widget.FriendlyVoice.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/quiet_title" />
        </LinearLayout>

        <TextView
            style="@style/Widget.FriendlyVoice.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/quiet_help" />

        <include
            android:id="@+id/quiet_range"
            layout="@layout/molecule_time_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
